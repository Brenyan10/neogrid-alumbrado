# Copie este archivo como .env (no lo suba a GitHub) y ajuste los valores.

# sqlite = copia de solo lectura en datos/ (la nube) · mssql = SQL Server directo (computador de la maqueta)
MODO_BD=mssql

# --- Solo para MODO_BD=mssql ---
MSSQL_SERVIDOR=localhost
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# Vacíos = autenticación de Windows (recomendado en el computador local)
MSSQL_USUARIO=
MSSQL_CLAVE=

# --- Solo en la nube ---
# Enlace directo a neogrid_datos.zip (activo de una versión de GitHub)
DATOS_URL=
# Clave que el puente de la maqueta envía en la cabecera X-API-Key (cadena larga y aleatoria)
CLAVE_INGESTA=
