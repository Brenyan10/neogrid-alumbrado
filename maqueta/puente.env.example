# Copie este archivo como puente.env en C:\neogrid (no lo suba a GitHub).
# Dirección pública del tablero en Render (sin barra al final)
URL_TABLERO=https://neogrid-alumbrado.onrender.com
# La misma clave que tiene la variable CLAVE_INGESTA del servicio en Render
CLAVE_INGESTA=
# Servidor de SQL Server (instancia predeterminada de este computador)
SQL_SERVIDOR=localhost
